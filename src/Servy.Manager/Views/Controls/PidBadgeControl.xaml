<UserControl x:Class="Servy.Manager.Views.Controls.PidBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resx="clr-namespace:Servy.Manager.Resources"
             x:Name="RootControl"
             mc:Ignorable="d">
  <Border Background="{DynamicResource PidBadgeBackgroundBrush}"
          CornerRadius="2"
          Padding="4,0,0,0"
          HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal">
      <ui:TextBlock Text="{x:Static resx:Strings.Label_Pid}"
                 Foreground="{DynamicResource PidBadgeForegroundBrush}"
                 FontSize="11"
                 VerticalAlignment="Center"
                 Margin="0,0,5,0"
                 AutomationProperties.Name="{x:Static resx:Strings.Label_Pid}" />

      <ui:TextBlock Text="{Binding Pid, ElementName=RootControl}"
                 Foreground="{DynamicResource PidBadgeForegroundBrush}"
                 FontWeight="Bold"
                 FontSize="12"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="{x:Static resx:Strings.Automation_PidValue_Name}"
                 AutomationProperties.AutomationId="PidValue"
                 AutomationProperties.HelpText="{x:Static resx:Strings.Automation_PidValue_HelpText}" />

      <ui:Button Command="{Binding CopyPidCommand, ElementName=RootControl}"
              Margin="5,0,0,0"
              Padding="4"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              ToolTip="{x:Static resx:Strings.Button_CopyPid}"
              FocusVisualStyle="{x:Null}"
              AutomationProperties.Name="{x:Static resx:Strings.Button_CopyPid}"
              AutomationProperties.AutomationId="CopyPidButton"
              AutomationProperties.HelpText="{x:Static resx:Strings.Automation_CopyPidButton_HelpText}">
        <ui:Button.Style>
          <Style TargetType="ui:Button">
            <Setter Property="Opacity" Value="0.5" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
        <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
              Fill="{DynamicResource PidBadgeForegroundBrush}"
              Stretch="Uniform"
              Width="12"
              Height="12" />
      </ui:Button>
    </StackPanel>
  </Border>
</UserControl>
