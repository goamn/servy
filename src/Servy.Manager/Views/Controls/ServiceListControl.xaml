<UserControl x:Class="Servy.Manager.Views.Controls.ServiceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Servy.UI.Converters;assembly=Servy.UI"
             xmlns:resx="clr-namespace:Servy.Manager.Resources"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

  <UserControl.Resources>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
  </UserControl.Resources>

  <ui:Card Margin="10" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <ui:TextBlock Text="{x:Static resx:Strings.Label_ServicesTab}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextBrush}" />

      <Grid Grid.Row="1" Margin="0,10,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:TextBox Grid.Column="0"
                    Height="30"
                    Margin="0,0,8,0"
                    VerticalContentAlignment="Center"
                    SnapsToDevicePixels="False"
                    UseLayoutRounding="False"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"
                    AutomationProperties.AutomationId="SidebarSearchTextBox"
                    AutomationProperties.HelpText="{x:Static resx:Strings.Automation_SidebarSearchTextBox_HelpText}"
                    AutomationProperties.Name="{x:Static resx:Strings.Automation_SidebarSearchTextBox_Name}"
                    Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
          <ui:TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </ui:TextBox.InputBindings>
        </ui:TextBox>

        <ui:Button Grid.Column="1"
                   Width="82"
                   Height="30"
                   AutomationProperties.AutomationId="SidebarSearchButton"
                   AutomationProperties.Name="{Binding SearchButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Command="{Binding SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Content="{Binding SearchButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   IsEnabled="{Binding IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" />
      </Grid>

      <ui:DataGrid Grid.Row="2"
                      AutoGenerateColumns="False"
                      AutomationProperties.AutomationId="SidebarServicesDataGrid"
                      AutomationProperties.Name="{x:Static resx:Strings.Automation_SidebarServicesDataGrid_Name}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      FocusVisualStyle="{x:Null}"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      IsSynchronizedWithCurrentItem="False"
                      ItemsSource="{Binding Services, RelativeSource={RelativeSource AncestorType=UserControl}, IsAsync=True}"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItem="{Binding SelectedService, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      Style="{StaticResource DataGridSelectionColorsStyle}">
        <ui:DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BaseServicesColumnHeaderStyle}">
            <Setter Property="Padding" Value="10,7" />
          </Style>

          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>

          <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Padding="0" Background="{TemplateBinding Background}">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ui:DataGrid.Resources>

        <ui:DataGrid.Columns>
          <DataGridTemplateColumn Width="*"
                                            CanUserReorder="False"
                                            CanUserResize="False"
                                            SortMemberPath="Name">
            <DataGridTemplateColumn.Header>
              <ui:TextBlock AutomationProperties.Name="{x:Static resx:Strings.Automation_ServiceNameHeader_Name}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static resx:Strings.Column_Service}" />
            </DataGridTemplateColumn.Header>

            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Padding="10,6"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource GridLinesBrush}"
                                        BorderThickness="0,0,0,1">
                  <ui:TextBlock VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding Name}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </ui:DataGrid.Columns>
      </ui:DataGrid>
    </Grid>
  </ui:Card>
</UserControl>
